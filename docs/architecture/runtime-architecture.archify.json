  "cards": [
    {
      "dot": "emerald",
      "title": "Primary path",
      "items": [
        "Upload → /api/extract → DisputeScenario (LLM)",
        "POST /api/negotiations spawns a background thread",
        "LangGraph: opening positions → CA → Bidder → Court, looping until resolved or max rounds",
        "Each node update is pushed to the browser as SSE; final state saved as JSON"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Uploaded documents are untrusted text placed into LLM prompts; <200 usable chars is rejected",
        "No auth: CORS admits only localhost / 127.0.0.1 origins",
        "Ronin tunnel needs the gitignored *.pem key (BatchMode, accept-new host key)",
        "ollama_lock serialises all LLM work; the rule-based risk screen skips it"
      ]
    },
    {
      "dot": "slate",
      "title": "Off the live path",
      "items": [
        "Cases / Analytics pages read static /data/manifest.json built by sync-data.mjs",
        "Batch scripts call orchestrator.run() and write batch_results/"
      ]
    }
  ]
